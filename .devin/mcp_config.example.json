{
  "mcpServers": {
    "john": {
      "command": "/absolute/path/to/john-mcp/.venv/bin/john-mcp",
      "args": [
        "--markdown-root", "/absolute/path/to/markdown",
        "--chroma-path", "/absolute/path/to/chroma",
        "--collection", "documents",
        "--embedding", "gemini",
        "--gemini-model", "gemini-embedding-001",
        "--gmail-credentials", "/absolute/path/to/oauth-client.json",
        "--gmail-token", "/absolute/path/to/gmail-token.json",
        "--attachment-root", "/absolute/path/to/attachments",
        "--source-root", "/absolute/path/to/original-sources"
      ]
    }
  }
}
